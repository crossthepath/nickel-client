# Normalize text files to LF in the repository; Windows tools get their native endings on checkout.
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.rc text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.ttf binary
*.woff2 binary
*.dxbc binary
