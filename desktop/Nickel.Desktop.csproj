<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nickel</AssemblyName><RootNamespace>Nickel.Desktop</RootNamespace><Version>1.1.0-beta</Version>
    <PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained><PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType><ApplicationIcon>Assets/Nickel/nickel.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Nickel/*.png"/>
    <Resource Include="Assets/Nickel/*.ttf"/>
    <Resource Include="Assets/Nickel/nickel.ico"/>
    <EmbeddedResource Include="../ui/catalog.js" LogicalName="Nickel.Catalog"/>
    <EmbeddedResource Include="../build/Release/Nickel.Overlay.dll" LogicalName="Nickel.Overlay"/>
  </ItemGroup>
</Project>
