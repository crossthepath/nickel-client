<!-- Nickel launcher: frame #08080B, panels #0F0F14, Satoshi typeface; see branding/nickel/README.md. -->
<Window x:Class="Nickel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nickel" Width="880" Height="540" Icon="Assets/Nickel/nickel.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        Background="#08080B" Foreground="#FFFFFF"
        FontFamily="./Assets/Nickel/#Satoshi" FontSize="14"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
 <Grid x:Name="Root" Width="880" Height="540" ClipToBounds="True" Background="#08080B"/>
</Window>
